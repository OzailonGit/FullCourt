# LLM provider: "ollama" (local, default), "anthropic", or "none".
# If the provider is unreachable or the model is not pulled, the app falls back to the
# rule-based parser and template explanations and says so in the sidebar.
FULLCOURT_LLM_PROVIDER=ollama

# Any model you have pulled (`ollama list`). Pick one that fits in memory alongside the app.
FULLCOURT_LLM_MODEL=qwen2.5:7b
# OLLAMA_HOST_URL=http://localhost:11434
# Context window requested from Ollama; the explanation prompt needs more than the 4096 default.
# FULLCOURT_OLLAMA_NUM_CTX=8192

# Only for FULLCOURT_LLM_PROVIDER=anthropic (also: pip install anthropic)
# ANTHROPIC_API_KEY=

# FULLCOURT_DEFAULT_SEASON=2025-26
# FULLCOURT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FULLCOURT_STAT_WEIGHT=0.6
# FULLCOURT_SEMANTIC_WEIGHT=0.4
# FULLCOURT_MISSING_SEMANTIC_POLICY=zero
# FULLCOURT_DEFAULT_MIN_GAMES=20
# FULLCOURT_DEFAULT_MIN_MINUTES=10
